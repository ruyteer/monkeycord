# Copie para .env (local) ou cadastre no painel do Railway/Vercel/Netlify

# ID da conta Cloudflare (Dashboard > canto direito / URL)
CF_ACCOUNT_ID=
# API Token com permissão "Realtime" / "Realtime Admin"
CF_API_TOKEN=
# App ID do RealtimeKit (Dashboard > Realtime > RealtimeKit > seu app)
RTK_APP_ID=

# Opcional: nome do preset criado no app (padrão: group_call_participant)
RTK_PRESET_NAME=group_call_participant
# Opcional: força todo mundo numa sala fixa (ignora o campo "sala")
RTK_MEETING_ID=
