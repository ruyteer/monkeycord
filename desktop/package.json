{
  "name": "monkeycord-desktop",
  "version": "2.0.1",
  "private": true,
  "description": "MonkeyCord — chat, voz e tela com a galera",
  "author": "MonkeyCord",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "icon": "node scripts/make-icon.js",
    "web": "node scripts/build-web.js",
    "dev": "npm run web && electron .",
    "dist": "npm run icon && npm run web && electron-builder --win --publish never",
    "release": "npm run icon && npm run web && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.monkeycord.desktop",
    "productName": "MonkeyCord",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-picker.js",
      "picker.html",
      "picker.js",
      "build/icon.png",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "MonkeyCord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "MonkeyCord"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ruyteer",
        "repo": "monkeycord",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "MonkeyCord",
        "schemes": [
          "monkeycord"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruyteer/monkeycord.git"
  }
}
